rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'soverixnet@gmail.com') ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'soverixnet@gmail.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.email is string && data.email.size() <= 256 &&
             data.plan is string && data.plan.size() <= 64 &&
             (!('role' in data) || (data.role is string && (data.role == 'super_admin' || data.role == 'admin' || data.role == 'reseller' || data.role == 'user'))) &&
             (!('resellerCredits' in data) || data.resellerCredits is number) &&
             (!('resellerVouchersGenerated' in data) || data.resellerVouchersGenerated is number) &&
             (!('managedByResellerId' in data) || (data.managedByResellerId is string && data.managedByResellerId.size() <= 128)) &&
             (!('planPriceBDT' in data) || data.planPriceBDT is number) &&
             (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 64)) &&
             (!('referredBy' in data) || (data.referredBy is string && data.referredBy.size() <= 128)) &&
             (!('referralCount' in data) || data.referralCount is number) &&
             (!('referralEarningsBDT' in data) || data.referralEarningsBDT is number) &&
             (!('referralBonusDays' in data) || data.referralBonusDays is number) &&
             (!('referralRewardTier' in data) || (data.referralRewardTier is string && data.referralRewardTier.size() <= 64)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 64)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('vipMasterKey' in data) || (data.vipMasterKey is string && data.vipMasterKey.size() <= 128)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 32)) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for UserPreferences
    function isValidUserPreferences(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.preferredProtocol is string && data.preferredProtocol.size() <= 32 &&
             data.killSwitch is bool &&
             data.cleanNetAdBlock is bool &&
             (!('malwareShield' in data) || data.malwareShield is bool) &&
             (!('stealthObfuscation' in data) || data.stealthObfuscation is bool) &&
             (!('quantumSafeKyber' in data) || data.quantumSafeKyber is bool) &&
             (!('dnsProvider' in data) || (data.dnsProvider is string && data.dnsProvider.size() <= 64)) &&
             (!('favoriteServerIds' in data) || (data.favoriteServerIds is list && data.favoriteServerIds.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for ConnectedDevice
    function isValidConnectedDevice(data, userId, deviceId) {
      return data.deviceId is string && data.deviceId == deviceId &&
             data.userId is string && data.userId == userId &&
             data.deviceName is string && data.deviceName.size() > 0 && data.deviceName.size() <= 128 &&
             data.deviceType is string && data.deviceType.size() <= 32 &&
             (!('virtualIp' in data) || (data.virtualIp is string && data.virtualIp.size() <= 64)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 128)) &&
             (!('activeSince' in data) || (data.activeSince is string && data.activeSince.size() <= 64)) &&
             (!('lastSeen' in data) || (data.lastSeen is string && data.lastSeen.size() <= 64));
    }

    // Validation for ConnectionLog
    function isValidConnectionLog(data, userId, logId) {
      return data.logId is string && data.logId == logId &&
             data.userId is string && data.userId == userId &&
             data.serverNodeId is string && data.serverNodeId.size() <= 64 &&
             data.protocol is string && data.protocol.size() <= 32 &&
             (!('serverName' in data) || (data.serverName is string && data.serverName.size() <= 128)) &&
             (!('connectedAt' in data) || (data.connectedAt is string && data.connectedAt.size() <= 64)) &&
             (!('durationSeconds' in data) || data.durationSeconds is number) &&
             (!('bytesDownloadedMB' in data) || data.bytesDownloadedMB is number) &&
             (!('bytesUploadedMB' in data) || data.bytesUploadedMB is number);
    }

    // Validation for ReferralRecord
    function isValidReferralRecord(data, userId, refId) {
      return data.refId is string && data.refId == refId &&
             data.referrerUserId is string && (data.referrerUserId == userId || isSuperAdmin()) &&
             data.referredUserId is string && data.referredUserId.size() <= 128 &&
             data.rewardStatus is string && (data.rewardStatus == 'credited' || data.rewardStatus == 'pending' || data.rewardStatus == 'claimed') &&
             (!('referredUserEmail' in data) || (data.referredUserEmail is string && data.referredUserEmail.size() <= 256)) &&
             (!('referredUserName' in data) || (data.referredUserName is string && data.referredUserName.size() <= 128)) &&
             (!('plan' in data) || (data.plan is string && data.plan.size() <= 64)) &&
             (!('rewardAmountBDT' in data) || data.rewardAmountBDT is number) &&
             (!('rewardBonusDays' in data) || data.rewardBonusDays is number) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Validation for Review
    function isValidReview(data, reviewId) {
      return data.reviewId is string && data.reviewId == reviewId &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 128 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() <= 1500 &&
             (!('authorRole' in data) || (data.authorRole is string && data.authorRole.size() <= 64)) &&
             (!('feedbackType' in data) || (data.feedbackType is string && (data.feedbackType == 'praise' || data.feedbackType == 'criticism' || data.feedbackType == 'suggestion' || data.feedbackType == 'general'))) &&
             (!('packageUsed' in data) || (data.packageUsed is string && data.packageUsed.size() <= 128)) &&
             (!('helpfulVotes' in data) || data.helpfulVotes is number) &&
             (!('verifiedBuyer' in data) || data.verifiedBuyer is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Health / Test Connection endpoint
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // Public Community Reviews & Comments collection
    match /reviews/{reviewId} {
      allow read: if true; // Everyone can see all reviews and comments
      allow create: if isValidId(reviewId) && isValidReview(incoming(), reviewId);
      allow update: if isValidId(reviewId) && (
        isSuperAdmin() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['helpfulVotes']) && incoming().helpfulVotes == existing().helpfulVotes + 1)
      );
      allow delete: if isSuperAdmin() && isValidId(reviewId);
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow get: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId);
      allow list: if isSuperAdmin(); // ONLY Super Admin / Owner can list all users
      allow create: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if (isOwner(userId) || isSuperAdmin() || isSignedIn()) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isSuperAdmin() && isValidId(userId);

      // Preferences Subcollection
      match /preferences/{prefId} {
        allow get: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(prefId);
        allow list: if isOwner(userId) || isSuperAdmin();
        allow create: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(prefId) && isValidUserPreferences(incoming(), userId);
        allow update: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(prefId) && isValidUserPreferences(incoming(), userId);
        allow delete: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(prefId);
      }

      // Connected Devices Subcollection
      match /devices/{deviceId} {
        allow get: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(deviceId);
        allow list: if isOwner(userId) || isSuperAdmin();
        allow create: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(deviceId) && isValidConnectedDevice(incoming(), userId, deviceId);
        allow update: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(deviceId) && isValidConnectedDevice(incoming(), userId, deviceId);
        allow delete: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(deviceId);
      }

      // Connection History Logs Subcollection
      match /history/{logId} {
        allow get: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId) || isSuperAdmin();
        allow create: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(logId) && isValidConnectionLog(incoming(), userId, logId);
        allow update: if false; // Logs are append-only immutable
        allow delete: if isSuperAdmin() && isValidId(userId) && isValidId(logId);
      }

      // Referral Tracking Subcollection
      match /referrals/{refId} {
        allow get: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(refId);
        allow list: if isOwner(userId) || isSuperAdmin();
        allow create: if isSignedIn() && isValidId(userId) && isValidId(refId) && isValidReferralRecord(incoming(), userId, refId);
        allow update: if (isOwner(userId) || isSuperAdmin()) && isValidId(userId) && isValidId(refId) && isValidReferralRecord(incoming(), userId, refId);
        allow delete: if isSuperAdmin() && isValidId(userId) && isValidId(refId);
      }
    }

  }
}
